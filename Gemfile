source "https://rubygems.org"

# Align local and CI on the same Ruby version
ruby "3.3.0"

gem "jekyll", "~> 4.3"
# Theme used by Jekyll (required when building via Actions)
gem "jekyll-theme-cayman", "~> 0.2"
# Multi-language support plugin (Polyglot)
gem "jekyll-polyglot", "~> 1.11"

# Useful for local serve on Ruby 3+
gem "webrick", "~> 1.8", group: :development
